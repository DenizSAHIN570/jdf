          "width": 166
        },
        {
          "id": "d14-s6-p8",
          "type": "text",
          "content": "The risk register was reviewed by the executive team in the final month of the quarter. Each item has a named owner responsible for the mitigation plan and its monthly status update.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d14-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Customer concentration — owner: Ravi Menon. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Data residency — owner: Liam O'Connor. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Currency exposure — owner: Ibrahim Sow. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Key-person dependency — owner: Ken Watanabe. Mitigation reviewed monthly; residual exposure rated high."
            }
          ],
          "position": {

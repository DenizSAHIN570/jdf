        {
          "id": "d16-s6",
          "type": "text",
          "content": "6. Risks and Mitigations",
          "heading": 2,
          "style": "h2",
          "tocEntry": "6. Risks and Mitigations",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 83
          },
          "width": 166
        },
        {
          "id": "d16-s6-p8",
          "type": "text",
          "content": "The risk register was reviewed by the executive team in the final month of the quarter. Each item has a named owner responsible for the mitigation plan and its monthly status update.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d16-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Hiring velocity — owner: Mara Lindqvist. Mitigation reviewed monthly; residual exposure rated medium."
            },
            {
              "content": "Vendor concentration — owner: Kwame Mensah. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Migration slippage — owner: Rafael Moreira. Mitigation reviewed monthly; residual exposure rated medium."
            },
            {
              "content": "Currency exposure — owner: Sena Yıldız. Mitigation reviewed monthly; residual exposure rated medium."
            }
          ],
          "position": {
            "x": 0,
            "y": 121.5
          },
          "width": 166
        },
        {
          "id": "d16-s6-p9",
          "type": "text",
          "content": "Detailed departmental commentary is available in the appendix distributed to budget owners.",

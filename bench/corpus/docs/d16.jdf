        },
        {
          "id": "d16-s4-p6",
          "type": "text",
          "content": "The finance team will publish a reconciliation to the statutory accounts after the audit.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 110.5
          },
          "width": 166
        },
        {
          "id": "d16-s5",
          "type": "text",
          "content": "5. Service Levels",
          "heading": 2,
          "style": "h2",
          "tocEntry": "5. Service Levels",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 128.4
          },
          "width": 166
        },
        {
          "id": "d16-s5-p7",
          "type": "text",
          "content": "Service levels are measured against the published SLA. Uptime excludes scheduled maintenance windows. P95 latency is measured at the edge over the whole quarter. Incidents count customer-impacting events of severity 2 or higher.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 142.8
          },
          "width": 166
        }
      ]
    },

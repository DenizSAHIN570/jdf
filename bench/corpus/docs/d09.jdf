        },
        {
          "id": "d09-s4-p6",
          "type": "text",
          "content": "Operational KPIs are refreshed weekly on the internal dashboard; this document is the quarterly point-in-time snapshot.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 72
          },
          "width": 166
        },
        {
          "id": "d09-s5",
          "type": "text",
          "content": "5. Service Levels",
          "heading": 2,
          "style": "h2",
          "tocEntry": "5. Service Levels",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 89.9
          },
          "width": 166
        },
        {
          "id": "d09-s5-p7",
          "type": "text",
          "content": "Service levels are measured against the published SLA. Uptime excludes scheduled maintenance windows. P95 latency is measured at the edge over the whole quarter. Incidents count customer-impacting events of severity 2 or higher.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 104.3
          },
          "width": 166
        },
        {

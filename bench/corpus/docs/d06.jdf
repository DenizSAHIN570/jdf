          "type": "text",
          "content": "Cobalt Health — Q3 2025 Operations Report",
          "heading": 1,
          "style": "h1",
          "tocEntry": "Cobalt Health — Q3 2025 Operations Report",
          "tocLevel": 1,
          "position": {
            "x": 0,
            "y": 0

          "position": {
            "x": 0,
            "y": 38.5
          },
          "width": 166
        },
        {
          "id": "d10-s4-p6",
          "type": "text",
          "content": "Management notes that comparisons to the prior year are affected by the change in revenue recognition adopted at the start of the fiscal year.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 110.5
          },
          "width": 166
        },
        {
          "id": "d10-s5",
          "type": "text",
          "content": "5. Service Levels",
          "heading": 2,
          "style": "h2",
          "tocEntry": "5. Service Levels",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 128.4
          },
          "width": 166
        },
        {
          "id": "d10-s5-p7",
          "type": "text",
          "content": "Service levels are measured against the published SLA. Uptime excludes scheduled maintenance windows. P95 latency is measured at the edge over the whole quarter. Incidents count customer-impacting events of severity 2 or higher.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 142.8
          },
          "width": 166
        }
      ]
    },

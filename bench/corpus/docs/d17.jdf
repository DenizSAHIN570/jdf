        {
          "id": "d17-s6",
          "type": "text",
          "content": "6. Risks and Mitigations",
          "heading": 2,
          "style": "h2",
          "tocEntry": "6. Risks and Mitigations",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 83
          },
          "width": 166
        },
        {
          "id": "d17-s6-p8",
          "type": "text",
          "content": "The risk register was reviewed by the executive team in the final month of the quarter. Each item has a named owner responsible for the mitigation plan and its monthly status update.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d17-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Regulatory change — owner: Ayşe Demir. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Migration slippage — owner: Mara Lindqvist. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Data residency — owner: Owen Gallagher. Mitigation reviewed monthly; residual exposure rated medium."
            },
            {
              "content": "Currency exposure — owner: Sofia Lindgren. Mitigation reviewed monthly; residual exposure rated medium."
            }
          ],
          "position": {
            "x": 0,
            "y": 121.5
          },
          "width": 166
        },
        {
          "id": "d17-s6-p9",
          "type": "text",
          "content": "Operational KPIs are refreshed weekly on the internal dashboard; this document is the quarterly point-in-time snapshot.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 182.9
          },
          "width": 166
        }
      ]
    },

      "elements": [
        {
          "id": "d18-s4",
          "type": "text",
          "content": "4. Pricing Changes",
          "heading": 2,
          "style": "h2",
          "tocEntry": "4. Pricing Changes",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 0
          },
          "width": 166
        },
        {
          "id": "d18-s4-p5",
          "type": "text",
          "content": "Pricing adjustments this quarter apply to new business from the effective date shown. Renewals honour the old price until the anniversary of the contract.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 14.4
          },
          "width": 166
        },
        {

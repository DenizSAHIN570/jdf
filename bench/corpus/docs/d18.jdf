        {
          "id": "d18-title",
          "type": "text",
          "content": "Ironwood Media — Q1 2025 Operations Report",
          "heading": 1,
          "style": "h1",
          "tocEntry": "Ironwood Media — Q1 2025 Operations Report",
          "tocLevel": 1,
          "position": {
            "x": 0,
            "y": 0
          },
          "width": 166
        },
        {
          "id": "d18-s1",
          "type": "text",
          "content": "1. Executive Summary",
          "heading": 2,
          "style": "h2",
          "tocEntry": "1. Executive Summary",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 29.5
          },
          "width": 166
        },
        {
          "id": "d18-s1-p0",
          "type": "text",
          "content": "This report summarises Ironwood Media's operating performance for Q1 2025. The business operates in regional streaming and publishing, and the quarter was shaped by two platform migrations and a reorganisation of the support function. Figures are unaudited and reflect management accounts as of quarter close.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 43.9
          },
          "width": 166
        },
        {
          "id": "d18-s1-owner",
          "type": "text",
          "content": "The Payments platform is owned by the Developer Experience team; its on-call lead for the quarter is Aiko Tanaka, who also chairs the weekly reliability review.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 80.4
          },
          "width": 166
        },
        {
          "id": "d18-s1-p1",
          "type": "text",
          "content": "Detailed departmental commentary is available in the appendix distributed to budget owners.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 104.6
          },
          "width": 166
        },
        {
          "id": "d18-s2",
          "type": "text",
          "content": "2. Regional Performance",
          "heading": 2,
          "style": "h2",
          "tocEntry": "2. Regional Performance",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 122.5
          },
          "width": 166
        },
        {
          "id": "d18-s2-p2",
          "type": "text",
          "content": "Regional results are reported in constant currency. Revenue reflects recognised subscription and services revenue; growth is quarter-over-quarter; churn is logo churn measured at renewal; NPS is the trailing 90-day relationship score.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 136.9
          },
          "width": 166
        }
      ]
    },

        {
          "id": "d18-s8",
          "type": "text",
          "content": "8. Outlook",
          "heading": 2,
          "style": "h2",
          "tocEntry": "8. Outlook",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 83

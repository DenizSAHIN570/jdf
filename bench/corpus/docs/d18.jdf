        {
          "id": "d18-s6",
          "type": "text",
          "content": "6. Risks and Mitigations",
          "heading": 2,
          "style": "h2",
          "tocEntry": "6. Risks and Mitigations",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 83
          },
          "width": 166
        },
        {
          "id": "d18-s6-p8",
          "type": "text",
          "content": "Top risks for the coming quarter, with the executive owner accountable for mitigation, are listed below. Items are ordered by residual exposure.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d18-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Capacity shortfall — owner: Ken Watanabe. Mitigation reviewed monthly; residual exposure rated medium."
            },
            {
              "content": "Regulatory change — owner: Priya Raghavan. Mitigation reviewed monthly; residual exposure rated medium."
            },
            {
              "content": "Currency exposure — owner: Kwame Mensah. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Security posture — owner: Liam O'Connor. Mitigation reviewed monthly; residual exposure rated high."
            }
          ],
          "position": {
            "x": 0,
            "y": 115.3
          },
          "width": 166
        },
        {
          "id": "d18-s6-p9",
          "type": "text",
          "content": "Operational KPIs are refreshed weekly on the internal dashboard; this document is the quarterly point-in-time snapshot.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 176.7
          },
          "width": 166
        },

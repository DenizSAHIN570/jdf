        {
          "id": "d19-s6",
          "type": "text",
          "content": "6. Risks and Mitigations",
          "heading": 2,
          "style": "h2",
          "tocEntry": "6. Risks and Mitigations",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 83
          },
          "width": 166
        },
        {
          "id": "d19-s6-p8",
          "type": "text",
          "content": "The risk register was reviewed by the executive team in the final month of the quarter. Each item has a named owner responsible for the mitigation plan and its monthly status update.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d19-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Key-person dependency — owner: Ingrid Solberg. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Regulatory change — owner: Yara Mansour. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Vendor concentration — owner: Zoe Papadakis. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Customer concentration — owner: Felix Brandt. Mitigation reviewed monthly; residual exposure rated high."
            }
          ],
          "position": {
            "x": 0,
            "y": 121.5
          },
          "width": 166
        },
        {
          "id": "d19-s6-p9",
          "type": "text",
          "content": "The finance team will publish a reconciliation to the statutory accounts after the audit.",
          "style": "body",
          "position": {

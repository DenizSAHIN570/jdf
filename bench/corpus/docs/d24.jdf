          "style": "body",
          "items": [
            {
              "content": "Capacity shortfall — owner: Luca Ferretti. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Hiring velocity — owner: Diego Álvarez. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Key-person dependency — owner: Yara Mansour. Mitigation reviewed monthly; residual exposure rated low."
            },
            {

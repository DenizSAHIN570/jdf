        {
          "id": "d03-s5",
          "type": "text",
          "content": "5. Service Levels",
          "heading": 2,
          "style": "h2",
          "tocEntry": "5. Service Levels",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 122.2

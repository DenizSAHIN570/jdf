        {
          "id": "d03-s1",
          "type": "text",
          "content": "1. Executive Summary",
          "heading": 2,
          "style": "h2",
          "tocEntry": "1. Executive Summary",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 29.5
          },
          "width": 166
        },
        {
          "id": "d03-s1-p0",
          "type": "text",
          "content": "This report summarises Borealis Energy's operating performance for Q3 2025. The business operates in distributed solar and storage, and the quarter was shaped by strong new-logo growth offset by elevated churn in one region. Figures are unaudited and reflect management accounts as of quarter close.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 43.9
          },
          "width": 166
        },
        {
          "id": "d03-s1-owner",
          "type": "text",
          "content": "The Checkout platform is owned by the Developer Experience team; its on-call lead for the quarter is Elena Petrova, who also chairs the weekly reliability review.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 74.2
          },
          "width": 166
        },
        {
          "id": "d03-s1-p1",
          "type": "text",
          "content": "Where a metric definition changed during the quarter, the prior quarter has been restated on the new basis.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 98.4
          },
          "width": 166
        },
        {
          "id": "d03-s2",
          "type": "text",
          "content": "2. Regional Performance",
          "heading": 2,
          "style": "h2",
          "tocEntry": "2. Regional Performance",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 116.3
          },
          "width": 166
        },
        {
          "id": "d03-s2-p2",
          "type": "text",
          "content": "The table below breaks down performance by sales region. Growth is measured against the prior quarter in constant currency, and churn counts customers who did not renew during the period.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 130.7
          },
          "width": 166
        }
      ]

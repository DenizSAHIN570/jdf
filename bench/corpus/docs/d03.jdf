        },
        {
          "id": "d03-s6-p8",
          "type": "text",
          "content": "Top risks for the coming quarter, with the executive owner accountable for mitigation, are listed below. Items are ordered by residual exposure.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d03-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Security posture — owner: Amara Okafor. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Currency exposure — owner: Chloé Martin. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Customer concentration — owner: Jonas Meyer. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Key-person dependency — owner: Hana Kovač. Mitigation reviewed monthly; residual exposure rated high."
            }

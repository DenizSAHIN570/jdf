        {
          "id": "d07-s6",
          "type": "text",
          "content": "6. Risks and Mitigations",
          "heading": 2,
          "style": "h2",
          "tocEntry": "6. Risks and Mitigations",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 0
          },
          "width": 166
        },
        {
          "id": "d07-s6-p8",
          "type": "text",
          "content": "The risk register was reviewed by the executive team in the final month of the quarter. Each item has a named owner responsible for the mitigation plan and its monthly status update.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 14.4
          },
          "width": 166
        },
        {
          "id": "d07-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Security posture — owner: Luca Ferretti. Mitigation reviewed monthly; residual exposure rated medium."
            },
            {
              "content": "Key-person dependency — owner: Ibrahim Sow. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Data residency — owner: Zoe Papadakis. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Vendor concentration — owner: Owen Gallagher. Mitigation reviewed monthly; residual exposure rated low."
            }
          ],
          "position": {
            "x": 0,
            "y": 38.5
          },
          "width": 166
        },
        {
          "id": "d07-s6-p9",
          "type": "text",
          "content": "Operational KPIs are refreshed weekly on the internal dashboard; this document is the quarterly point-in-time snapshot.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 99.9
          },
          "width": 166
        },
        {
          "id": "d07-s7",
          "type": "text",
          "content": "7. Vendor Spend",
          "heading": 2,
          "style": "h2",
          "tocEntry": "7. Vendor Spend",
          "tocLevel": 2,
          "position": {

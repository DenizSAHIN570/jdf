        {
          "id": "d07-title",
          "type": "text",
          "content": "Delta Foods — Q1 2025 Operations Report",
          "heading": 1,
          "style": "h1",
          "tocEntry": "Delta Foods — Q1 2025 Operations Report",
          "tocLevel": 1,
          "position": {
            "x": 0,
            "y": 0
          },
          "width": 166
        },
        {
          "id": "d07-s1",
          "type": "text",
          "content": "1. Executive Summary",
          "heading": 2,
          "style": "h2",
          "tocEntry": "1. Executive Summary",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 29.5
          },
          "width": 166
        },
        {
          "id": "d07-s1-p0",
          "type": "text",
          "content": "This report summarises Delta Foods's operating performance for Q1 2025. The business operates in cold-chain grocery distribution, and the quarter was shaped by a disciplined cost programme and a pricing reset. Figures are unaudited and reflect management accounts as of quarter close.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 43.9
          },
          "width": 166
        },
        {
          "id": "d07-s1-owner",
          "type": "text",
          "content": "The Search platform is owned by the Payments team; its on-call lead for the quarter is Mateo Rossi, who also chairs the weekly reliability review.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 74.2
          },
          "width": 166
        },
        {
          "id": "d07-s1-p1",
          "type": "text",
          "content": "All figures in this section are rounded; totals may not sum exactly.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 92.2
          },
          "width": 166
        },
        {
          "id": "d07-s2",
          "type": "text",
          "content": "2. Regional Performance",
          "heading": 2,
          "style": "h2",
          "tocEntry": "2. Regional Performance",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 103.9
          },
          "width": 166
        },
        {
          "id": "d07-s2-p2",
          "type": "text",
          "content": "Regional results are reported in constant currency. Revenue reflects recognised subscription and services revenue; growth is quarter-over-quarter; churn is logo churn measured at renewal; NPS is the trailing 90-day relationship score.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 118.2
          },
          "width": 166
        },
        {
          "id": "d07-s2-table",

        {
          "id": "d02-s4",
          "type": "text",
          "content": "4. Pricing Changes",
          "heading": 2,
          "style": "h2",
          "tocEntry": "4. Pricing Changes",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 0
          },
          "width": 166
        },
        {
          "id": "d02-s4-p5",
          "type": "text",
          "content": "The following list-price changes were approved by the pricing committee and communicated to customers at least 30 days ahead of their effective date. Existing contracts move to the new price at renewal.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 14.4
          },
          "width": 166

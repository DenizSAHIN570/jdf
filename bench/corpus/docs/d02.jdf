  "pages": [
    {
      "id": "d02-page-1",
      "elements": [
        {
          "id": "d02-title",
          "type": "text",
          "content": "Acme Logistics — Q1 2025 Operations Report",
          "heading": 1,
          "style": "h1",
          "tocEntry": "Acme Logistics — Q1 2025 Operations Report",
          "tocLevel": 1,
          "position": {
            "x": 0,
            "y": 0
          },
          "width": 166
        },
        {
          "id": "d02-s1",
          "type": "text",
          "content": "1. Executive Summary",
          "heading": 2,
          "style": "h2",
          "tocEntry": "1. Executive Summary",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 29.5
          },
          "width": 166
        },
        {
          "id": "d02-s1-p0",
          "type": "text",
          "content": "This report summarises Acme Logistics's operating performance for Q1 2025. The business operates in freight and last-mile delivery, and the quarter was shaped by steady demand and margin pressure from freight costs. Figures are unaudited and reflect management accounts as of quarter close.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 43.9
          },
          "width": 166
        },
        {
          "id": "d02-s1-owner",
          "type": "text",
          "content": "The Ingest platform is owned by the Growth team; its on-call lead for the quarter is Hana Kovač, who also chairs the weekly reliability review.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 74.2
          },
          "width": 166
        },
        {
          "id": "d02-s1-p1",
          "type": "text",
          "content": "The finance team will publish a reconciliation to the statutory accounts after the audit.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 92.2
          },
          "width": 166
        },
        {
          "id": "d02-s2",
          "type": "text",
          "content": "2. Regional Performance",
          "heading": 2,
          "style": "h2",
          "tocEntry": "2. Regional Performance",
          "tocLevel": 2,
          "position": {
            "x": 0,
            "y": 110.1
          },
          "width": 166
        },
        {
          "id": "d02-s2-p2",
          "type": "text",
          "content": "Regional results are reported in constant currency. Revenue reflects recognised subscription and services revenue; growth is quarter-over-quarter; churn is logo churn measured at renewal; NPS is the trailing 90-day relationship score.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 124.4
          },
          "width": 166
        }
      ]
    },

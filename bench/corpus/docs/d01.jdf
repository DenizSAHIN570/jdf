          "width": 166
        },
        {
          "id": "d01-s6-p8",
          "type": "text",
          "content": "The risk register was reviewed by the executive team in the final month of the quarter. Each item has a named owner responsible for the mitigation plan and its monthly status update.",
          "style": "body",
          "position": {
            "x": 0,
            "y": 97.4
          },
          "width": 166
        },
        {
          "id": "d01-s6-list",
          "type": "list",
          "listType": "unordered",
          "style": "body",
          "items": [
            {
              "content": "Customer concentration — owner: Noor Rahman. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Data residency — owner: Chloé Martin. Mitigation reviewed monthly; residual exposure rated low."
            },
            {
              "content": "Hiring velocity — owner: Owen Gallagher. Mitigation reviewed monthly; residual exposure rated high."
            },
            {
              "content": "Migration slippage — owner: Samuel Adeyemi. Mitigation reviewed monthly; residual exposure rated high."
            }
